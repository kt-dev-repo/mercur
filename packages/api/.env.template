# The storefront runs on :3000 (see mercur-storefront's .env.example). :8000 is the
# Medusa starter default and is kept only for other clients — an origin missing here
# fails in the browser as an opaque CORS error with nothing logged server-side.
STORE_CORS=http://localhost:3000,http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:7000,http://localhost:7001,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
MERCUR_VENDOR_URL=http://localhost:7001
# The subscriber POSTs to this URL directly, so it is the ROUTE, not the storefront
# origin. Pointed at the origin the request hits Next's locale middleware and is
# answered with a 307 redirect to /de, which is not `response.ok` — so every product
# event logs "revalidation rejected: 307" and the cache is never dropped. Verified
# against the storefront on 2026-09-07.
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=supersecret