# These are pnpm/bun options, and npm ignores this file entirely — it only reads the
# root .npmrc when workspaces are in play, and warns on every command that it is
# skipping this one. That warning is expected; see "Why npm, when upstream uses bun"
# in the repository README.
#
# The file is kept because it is what makes Medusa resolvable under an isolated
# linker: without these hoist patterns @medusajs/* stays nested per-package and the
# panels cannot resolve it at build time. Deleting it would silently break anyone who
# installs with pnpm or bun.
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
auto-install-peers=true
