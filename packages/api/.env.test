# Test environment. Committed on purpose: these are throwaway local credentials and
# CI uses the same file against its own service containers.
#
# @medusajs/test-utils builds its own connection for creating and dropping the
# per-run test database and reads DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD —
# NOT DATABASE_URL (see node_modules/@medusajs/test-utils/dist/database.js). Set
# only DATABASE_URL and the runner silently tries localhost:5432 and fails with a
# bare AggregateError. Both are needed: these four for the runner, DATABASE_URL for
# the app config it boots.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=medusa
DB_PASSWORD=medusa

DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa-test
REDIS_URL=redis://localhost:6380

JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001
