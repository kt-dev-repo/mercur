# ---------------------------------------------------------------------------
# Mercur on Dokploy — paste this into the service's "Environment" tab.
# See deploy/README.md, Step 3.
#
# Everything above the "Optional" divider is required. Replace api.example.com
# with your own hostname throughout.
# ---------------------------------------------------------------------------

# --- Routing and public origin -------------------------------------------
# DOMAIN is the bare hostname: no scheme, no path, no trailing slash. Dokploy's
# router uses it to recognise requests for this stack. Without it every request
# gets the router's own plain-text "404 page not found".
DOMAIN=api.example.com

# MERCUR_BACKEND_URL is the full origin the BROWSER uses, and it is compiled into
# the admin and vendor panels when the image is built.
#
# Start with http:// — you will not have a certificate on the first deploy. Once
# https works, change this and the CORS values below, then REBUILD (not restart);
# only a rebuild recompiles the panels.
#
# If the scheme here does not match the URL in your address bar, the login page
# loads but signing in fails with "Failed to fetch".
MERCUR_BACKEND_URL=http://api.example.com

# --- Secrets -------------------------------------------------------------
# JWT_SECRET and COOKIE_SECRET: generate each separately with
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# POSTGRES_PASSWORD goes into a connection URL, so it must be URL-safe. Generate
# it with hex, NOT base64:
#   openssl rand -hex 32
# `openssl rand -base64 48` emits "/", "+" and "=", and a "/" breaks the
# DATABASE_URL this file builds — the backend then never connects and the error
# does not mention the password. (If you must use a password with those
# characters, percent-encode them: / = %2F, + = %2B, = = %3D.)
#
# POSTGRES_PASSWORD is written into the database on first start. Changing it
# later does not update the database, it only locks the backend out — recovering
# means deleting the postgres-data volume, and your data with it. Set it once.
POSTGRES_PASSWORD=CHANGE_ME

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=mercur
POSTGRES_DB=mercur

# --- CORS ----------------------------------------------------------------
# Comma-separated origins. The panels are served from MERCUR_BACKEND_URL itself,
# so that exact origin — same scheme, same host — must appear in ADMIN_CORS,
# VENDOR_CORS and AUTH_CORS. Add your storefront to STORE_CORS and AUTH_CORS
# once it exists.
#
# Each of these defaults to MERCUR_BACKEND_URL if you leave it out, so the panels
# work out of the box. Keep them listed explicitly — you will need to edit them
# when you switch to https and when you add a storefront.
STORE_CORS=http://api.example.com
ADMIN_CORS=http://api.example.com
VENDOR_CORS=http://api.example.com
AUTH_CORS=http://api.example.com

# --- Serving over plain http --------------------------------------------
# This ships as `true` because the guide has you start on http://, before your
# certificate exists — and on http the panels cannot log in at all without it.
#
# Medusa marks the session cookie `Secure` whenever NODE_ENV=production, and a
# browser will not store a Secure cookie from an http page. The failure is silent:
# the login request returns 200 and the panel drops straight back to its login
# screen with no error. This removes the Secure flag.
#
# It is a real downgrade — session cookies then travel in the clear. Set it to
# false and REBUILD as soon as https works (Step 6).
INSECURE_COOKIES=true

# --- First boot ----------------------------------------------------------
# Runs migrations on every start of the `backend` service. Safe to leave on.
RUN_MIGRATIONS=true

# Seeds a demo catalog and three demo sellers (seller@mercur.dev,
# kickz@mercur.dev, trailhead@mercur.dev — all with password `supersecret`).
#
# Safe to leave on: the seed asks the database whether the demo seller already
# exists and stops there if it does, so it never touches a marketplace you have
# started using. Turn it off if you would rather not have demo data at all.
RUN_SEED=false

# ===========================================================================
# Optional — every setting below has a working default. Leave them commented
# out unless you need them.
# ===========================================================================

# --- Managed database ----------------------------------------------------
# Set this and the bundled postgres service is ignored. Always give an explicit
# sslmode: Medusa turns database SSL on whenever NODE_ENV=production.
# DATABASE_URL=postgres://user:password@host:5432/mercur?sslmode=require

# --- Router ---------------------------------------------------------------
# Dokploy's certificate resolver, and the router name prefix. The defaults suit
# Dokploy; change TRAEFIK_ROUTER only if you run several of these on one host.
# TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_ROUTER=mercur

# --- Where uploaded files live -------------------------------------------
# Product images and videos, seller logos and banners — everything uploaded
# through the panels.
#
#   local   the `uploads` volume inside the stack. The default. Simple, and lost
#           with the volume — nothing backs it up.
#   s3      RustFS or any S3-compatible store. Durable, and required if you ever
#           run more than one backend replica.
#
# It applies to the whole deployment; Medusa allows exactly one file provider.
# Switching only redirects NEW uploads — files already stored keep working from
# wherever they were written. To move the old ones across afterwards, run
# `backup.sh migrate-uploads` (see deploy/README.md).
FILE_STORAGE=local

# Required when FILE_STORAGE=s3. Use a SEPARATE bucket from your backups: this
# one has to be publicly readable, and your database dumps must not be.
# S3_FILE_BUCKET=mercur-media
#
# The address that serves the bucket to a browser. Every image URL is built from
# it, so if it is wrong uploads still succeed and every image renders broken.
# S3_FILE_PUBLIC_URL=https://rustfs.example.com/mercur-media
#
# S3_FILE_PREFIX=
#
# Leave unset for RustFS and other self-hosted S3 servers: the ACL header is then
# omitted entirely and public read comes from the bucket policy. On AWS, set
# public-read if you rely on per-object ACLs.
# S3_FILE_ACL=public-read
#
# Used only when FILE_STORAGE=local: the origin compiled into every uploaded
# file's URL. Defaults to MERCUR_BACKEND_URL/static, which is almost always right.
# FILE_BACKEND_URL=http://api.example.com/static

# --- Backups to S3 (RustFS, AWS S3, R2, B2, Spaces) -----------------------
# Off unless COMPOSE_PROFILES=backup is set. With it set, a sidecar dumps the
# database on a schedule and uploads it to your bucket. Create the bucket first
# — the backup service does not create it for you.
#
# COMPOSE_PROFILES=backup
#
# S3_ENDPOINT, the credentials and the path-style setting below are shared with
# FILE_STORAGE=s3 above — one RustFS, two buckets.
#
# S3_ENDPOINT is your RustFS address. Leave it out ONLY for real AWS S3.
# S3_ENDPOINT=https://rustfs.example.com
# S3_BUCKET=mercur-backups
# S3_PREFIX=mercur
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
#
# S3_REGION only matters for AWS; anything else can keep the default.
# S3_REGION=us-east-1
#
# Path-style addressing (bucket in the path, not the hostname). RustFS and most
# self-hosted S3 servers need this; set it false for real AWS S3.
# S3_FORCE_PATH_STYLE=true
#
# How the backup client should treat the endpoint. "Other" suits RustFS and any
# other self-hosted S3 server, and is the default. Set it to the matching rclone
# provider name if you point these at a hosted service instead — AWS,
# Cloudflare (R2), B2, DigitalOcean.
# S3_PROVIDER=Other
#
# 86400 = daily. Backups older than BACKUP_RETENTION_DAYS are pruned after each
# successful run; set retention to 0 to keep everything forever.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=30

# --- Storefront integration ----------------------------------------------
# MERCUR_VENDOR_URL=http://api.example.com/seller
# STOREFRONT_REVALIDATE_URL=https://shop.example.com
# STOREFRONT_REVALIDATE_SECRET=CHANGE_ME
