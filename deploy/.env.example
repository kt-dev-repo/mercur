# ---------------------------------------------------------------------------
# Mercur on Dokploy — copy these into the Dokploy service's "Environment" tab.
# Every value below is required unless marked optional.
# ---------------------------------------------------------------------------

# --- Public origin -------------------------------------------------------
# The https origin Dokploy serves the backend on. This is BAKED INTO the admin
# and vendor panels at image build time, so changing it needs a rebuild.
MERCUR_BACKEND_URL=https://api.example.com

# --- Secrets -------------------------------------------------------------
# Generate each one separately, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=mercur
POSTGRES_DB=mercur

# Leave DATABASE_URL unset to use the bundled postgres service. To use a managed
# database instead, set it here — and keep an explicit sslmode, because Medusa
# turns database SSL on whenever NODE_ENV=production:
#   managed/hosted Postgres  -> ?sslmode=require
#   a sidecar without TLS    -> ?sslmode=disable
# DATABASE_URL=postgres://user:password@host:5432/mercur?sslmode=require

# --- CORS ----------------------------------------------------------------
# Comma-separated origins. The panels are served from MERCUR_BACKEND_URL itself,
# so that origin must appear in ADMIN_CORS, VENDOR_CORS and AUTH_CORS.
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://api.example.com
VENDOR_CORS=https://api.example.com
AUTH_CORS=https://api.example.com,https://shop.example.com

# --- Uploads -------------------------------------------------------------
# Baked into every uploaded file's URL by the local file provider. Leave unset to
# default to ${MERCUR_BACKEND_URL}/static. Switch to the S3 provider in
# packages/api/medusa-config.ts if you run more than one backend replica.
# FILE_BACKEND_URL=https://api.example.com/static

# --- First boot ----------------------------------------------------------
# Runs migrations on every start of the `backend` service. Safe to leave on.
RUN_MIGRATIONS=true
# Seeds the demo catalog + demo seller (seller@mercur.dev / supersecret).
# Set to true for the FIRST deploy only, then set it back to false and redeploy.
RUN_SEED=false

# --- Optional integrations ----------------------------------------------
# MERCUR_VENDOR_URL=https://api.example.com/seller
# STOREFRONT_REVALIDATE_URL=https://shop.example.com
# STOREFRONT_REVALIDATE_SECRET=CHANGE_ME
